# Desarrollo local: copiar a .env y cargar las variables manualmente (Node no lee .env automáticamente).
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/cuenta.db

# Contraseña de administrador (mín. 10 caracteres en producción). Alias antiguo: ADMIN_PIN.
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
# Opcional: secreto para firmar la sesión (si no se define, se deriva de la contraseña).
SESSION_SECRET=

CURRENCY=COP
LOCALE=es-CO

# Respaldos automáticos (VACUUM INTO) en BACKUP_DIR; 0 desactiva. El volumen NO es un respaldo externo.
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14

# Límite de peticiones en memoria (una sola réplica). RATE_LIMIT=off solo para pruebas.
# TRUST_PROXY=1 usa X-Forwarded-For (por defecto activo en producción, p. ej. Railway).
TRUST_PROXY=
RATE_LIMIT=on

# Railway: NODE_ENV=production, DB_PATH=/data/cuenta.db, BACKUP_DIR=/data/backups, volumen montado en /data.
