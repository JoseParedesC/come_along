# Desarrollo local: exporta estas variables a mano (Node no lee .env automáticamente).

# PostgreSQL (obligatoria). En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:clave@localhost:5432/come_along
# Solo si te conectas con la URL pública (proxy) de Railway u otro proveedor que exija TLS.
DATABASE_SSL=false
PG_POOL_MAX=10

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

CURRENCY=COP
LOCALE=es-CO

# Límite de peticiones en memoria (una sola réplica). RATE_LIMIT=off lo desactiva.
# TRUST_PROXY=1 usa X-Forwarded-For (por defecto activo con NODE_ENV=production, p. ej. Railway).
TRUST_PROXY=
RATE_LIMIT=on
